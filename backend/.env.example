# AssureDen — Environment Configuration
# Copy to .env and fill in real values before running

# ── Database ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assureden
POSTGRES_USER=assureden
POSTGRES_PASSWORD=assureden

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── JWT ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── App ────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=AssureDen

# ── Storage ────────────────────────────────────────────────────
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_LOCAL_BASE_PATH=artifacts
